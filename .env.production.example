# Template Environment Variables Produksi — PPO Kanban Board
# Salin file ini menjadi .env.production di server deployment.
# PERINGATAN: JANGAN simpan file .env.production ke Git repository.

# Port HTTP Frontend / Reverse Proxy di host
PORT=80

# Konfigurasi Database PostgreSQL
POSTGRES_DB=ppo_kanban_prod
POSTGRES_USER=ppo_app
# Gunakan password yang kuat dan unik (minimal 32 karakter acak)
POSTGRES_PASSWORD=ganti_dengan_database_password_kuat_dan_acak_32_karakter

# Rahasia Sesi (Session & CSRF HMAC Secret)
# Wajib minimal 32 karakter acak (mis. openssl rand -base64 32)
SESSION_SECRET=ganti_dengan_session_secret_acak_minimal_32_karakter

# Pengaturan Cookie
# Wajib 'true' saat aplikasi dijalankan di balik HTTPS / reverse proxy TLS
COOKIE_SECURE=true

# Akun Inisial Administrator Sistem (Hanya di-bootstrap saat database pertama kali dibuat)
BOOTSTRAP_ADMIN_EMAIL=admin@bank.corp.internal
BOOTSTRAP_ADMIN_PASSWORD=ganti_dengan_admin_password_yang_sangat_kuat_16_karakter
